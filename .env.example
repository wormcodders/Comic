# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Keep production behind HTTPS. For local HTTP Docker testing, set this to false.
SESSION_COOKIE_SECURE=true

# Optional: use a separate stable key for encrypted API credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Production outside Docker also needs a shared rate-limit backend.
RATELIMIT_STORAGE_URI=

# Prefer the local create-admin command. These enable optional first-run bootstrap.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
